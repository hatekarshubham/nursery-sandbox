rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the caller signed in?
    function isSignedIn() {
      return request.auth != null;
    }

    // All app data (products, categories, sales, purchases, users, ...)
    // is only accessible to authenticated users. Accounts are created
    // manually by the admin, so there is no public/anonymous access.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
